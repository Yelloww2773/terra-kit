  "a_baum": {
   "description": "Organigramm oder Hierarchie (Instanzenzug, Zuständigkeiten, Gliederung eines Begriffs). Das Kit berechnet das Layout; Kanten führen stets vom Elternknoten zum Kind.",
   "required": [
    "knoten"
   ],
   "additionalProperties": false,
   "properties": {
    "typ": true,
    "variante": true,
    "titel": {
     "$ref": "#/$defs/text"
    },
    "richtung": {
     "enum": [
      "unten",
      "rechts"
     ],
     "description": "unten: Wurzel oben (Standard bis sechs Blätter); rechts: Wurzel links (Standard ab sieben Blättern)"
    },
    "knoten": {
     "type": "array",
     "minItems": 2,
     "maxItems": 24,
     "items": {
      "type": "object",
      "required": [
       "id",
       "text"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$"
       },
       "text": {
        "$ref": "#/$defs/text"
       },
       "eltern": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$",
        "description": "id des übergeordneten Knotens; fehlt nur bei der Wurzel"
       },
       "label": {
        "type": "string",
        "minLength": 1,
        "description": "Beschriftung der Kante vom Elternknoten, etwa „Berufung“"
       },
       "art": {
        "enum": [
         "normal",
         "betont",
         "neben"
        ],
        "description": "betont: Provinzfarbe; neben: gestrichelt (etwa außerhalb der Hierarchie)"
       }
      }
     }
    },
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "nachweis": {
     "$ref": "#/$defs/text"
    },
    "lesehilfe": {
     "$ref": "#/$defs/text"
    },
    "wichtig": {
     "type": "boolean"
    }
   }
  },
  "a_bild": {
   "description": "Rasterbild (PNG, JPEG, WebP) mit Pflichtangaben zu Quelle und Lizenz. datei: Pfad relativ zur werk.json; daten: eingebettet als data-URI (python3 bild.py werk.json --einbetten).",
   "required": [
    "beschreibung",
    "quelle",
    "lizenz"
   ],
   "additionalProperties": false,
   "oneOf": [
    {
     "required": [
      "datei"
     ]
    },
    {
     "required": [
      "daten"
     ]
    }
   ],
   "properties": {
    "typ": true,
    "variante": true,
    "titel": {
     "$ref": "#/$defs/text"
    },
    "datei": {
     "type": "string",
     "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+\\.(png|jpe?g|webp|PNG|JPE?G|WEBP)$"
    },
    "daten": {
     "type": "string",
     "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$"
    },
    "beschreibung": {
     "$ref": "#/$defs/text",
     "description": "Alternativtext; Pflicht"
    },
    "quelle": {
     "$ref": "#/$defs/text",
     "description": "Herkunft, etwa Kurzzitat und Seite oder „Eigene Aufnahme“"
    },
    "lizenz": {
     "$ref": "#/$defs/text",
     "description": "etwa „eigenes Werk“, „CC BY 4.0“, „gemeinfrei“, „Zitat (§ 42f UrhG)“, „freies Werk (§ 7 UrhG)“"
    },
    "urheber": {
     "type": "string",
     "minLength": 1,
     "description": "bei fremden Werken: Urheberin oder Urheber für die Namensnennung"
    },
    "breite": {
     "type": "integer",
     "minimum": 30,
     "maximum": 100,
     "description": "Breite in Prozent des Satzspiegels, Standard 100"
    },
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "nachweis": {
     "$ref": "#/$defs/text"
    },
    "lesehilfe": {
     "$ref": "#/$defs/text"
    },
    "wichtig": {
     "type": "boolean"
    }
   }
  },
