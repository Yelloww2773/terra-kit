{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "terra-kit/schema.json/4.0",
 "title": "(c) Oliver Bedernik · Terra-Kit 4.0 · Werkschema (Kapitel, Abschnitte, Bausteine)",
 "description": "Kapitel statt Provinz, Abschnitt statt Kachel, Blockfolge statt Bausteinen. Inline: **Fachbegriff**, *Latein*, [[B2]] Abschnittsverweis, ^[Randbeleg] mit @Sigle (Fundstelle) für Quellen, {{abb:id}} und {{tab:id}} für Abbildungs- und Tabellenverweise. Rollen als Farbschlüssel, Prüfdimensionen je Abschnitt, Diagramme (Fluss, BPMN), Merkband, Zitat, Kapitelabschluss.",
 "type": "object",
 "required": [
  "standard",
  "meta",
  "modul",
  "quellen",
  "kapitel"
 ],
 "additionalProperties": false,
 "properties": {
  "standard": {
   "const": "4.0"
  },
  "meta": {
   "type": "object",
   "required": [
    "titel",
    "untertitel",
    "version",
    "stand",
    "urheber"
   ],
   "properties": {
    "titel": {
     "type": "string"
    },
    "kurz": {
     "type": "string"
    },
    "untertitel": {
     "type": "string"
    },
    "reihe": {
     "type": "string"
    },
    "lehrveranstaltung": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "stand": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "urheber": {
     "const": "(c) Oliver Bedernik"
    },
    "ort": {
     "type": "string"
    },
    "probesatz": {
     "type": "string"
    },
    "provinzen": {
     "type": "array",
     "description": "Provinzregister der ganzen Terra (Titelseite, Daumenregister); im Probesatz auch Provinzen ohne Inhalt",
     "items": {
      "type": "object",
      "required": [
       "code",
       "nr",
       "name_de",
       "farbe"
      ],
      "properties": {
       "code": {
        "type": "string"
       },
       "nr": {
        "type": "string"
       },
       "name_de": {
        "type": "string"
       },
       "farbe": {
        "type": "string"
       }
      }
     }
    },
    "farbschema": {
     "enum": [
      "nacht",
      "bordeaux",
      "tanne",
      "graphit"
     ]
    },
    "titelseite": {
     "enum": [
      "band",
      "einband",
      "karte",
      "klassisch",
      "studienbuch",
      "grundriss",
      "handbuch",
      "kurzlehrbuch",
      "leinen",
      "halbleinen",
      "umschlag",
      "relief",
      "relief-halbleinen",
      "relief-umschlag",
      "band-relief",
      "band-bezug",
      "band-rahmen"
     ],
     "description": "Gestaltung der Titelseite; Standard band-relief (seit 4.0), band ist die Fassung von Kit 3.7"
    },
    "titel_stil": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "terra-kursiv",
       "band-hoch",
       "band-schmal",
       "band-unten",
       "relief-dicht",
       "relief-papier",
       "papier-weiss",
       "fussband",
       "relief-blind",
       "relief-weit",
       "relief-kraeftig",
       "papier-bronze",
       "papier-deutlich",
       "papier-praegung",
       "papier-zaehl",
       "ohne-fileten",
       "papier-hell"
      ]
     },
     "description": "Abwandlungen der Titelseiten band-relief, band-bezug, band-rahmen"
    },
    "typ": {
     "enum": [
      "werk",
      "referenz"
     ],
     "description": "referenz: Musterwerk des Kits mit Abdeckungsprüfung; Standard werk"
    }
   }
  },
  "modul": {
   "type": "object",
   "required": [
    "domaene",
    "zitierstil"
   ],
   "properties": {
    "domaene": {
     "enum": [
      "recht",
      "wirtschaft",
      "gemischt",
      "sonstige"
     ]
    },
    "zitierstil": {
     "enum": [
      "AZR",
      "APA7"
     ]
    },
    "primaerquelle": {
     "type": "string"
    },
    "sekundaerquelle": {
     "type": "string"
    },
    "stand_art": {
     "type": "string"
    },
    "pruefdimensionen": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "anker": {
     "type": "string"
    }
   }
  },
  "quellen": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "kurz"
    ],
    "properties": {
     "kurz": {
      "type": "string",
      "minLength": 1,
      "description": "Kurzzitat, eindeutig; erscheint im Quellenverzeichnis"
     },
     "fn": {
      "type": "string",
      "description": "Kurzform (AZR) bzw. Kurzbeleg (APA); im Buchsatz Grundlage des Quellenverzeichnisses"
     },
     "voll": {
      "type": "string"
     },
     "gattung": {
      "enum": [
       "literatur",
       "beitrag",
       "kommentar",
       "aufsatz",
       "lv",
       "daten",
       "online",
       "norm",
       "entscheidung",
       "materialien"
      ]
     },
     "rand": {
      "type": "string",
      "maxLength": 14,
      "description": "Randsigle im Randbeleg (Autor oder Sigle); fehlt sie, gilt kurz"
     },
     "sigle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9ÄÖÜäöü]+$",
      "description": "Schlüssel für Randbelege (@Sigle in ^[…]); fehlt sie, gilt kurz, sofern es nur aus Buchstaben und Ziffern besteht"
     }
    },
    "anyOf": [
     {
      "required": [
       "voll"
      ]
     },
     {
      "required": [
       "gattung"
      ]
     }
    ]
   }
  },
  "kapitel": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/kapitel"
   }
  },
  "rollen": {
   "type": "object",
   "description": "Farbschlüssel des Werks: Rolle → Name und Kit-Farbe; Diagramme, Zeitstrahl, Merkband und Vergleich färben nach Rolle",
   "additionalProperties": {
    "type": "object",
    "required": [
     "name",
     "farbe"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "farbe": {
      "enum": [
       "indigo",
       "petrol",
       "moos",
       "bronze",
       "terrakotta",
       "wein",
       "pflaume",
       "grau",
       "tinte"
      ]
     }
    }
   }
  },
  "personen": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "suche",
     "rolle",
     "funktion"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "suche": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "rolle": {
      "type": "string"
     },
     "funktion": {
      "type": "string"
     }
    }
   }
  },
  "abkuerzungen": {
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2,
    "items": {
     "type": "string"
    }
   }
  },
  "quellenkritik": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "quelle",
     "befund",
     "richtig",
     "abschnitt"
    ],
    "properties": {
     "quelle": {
      "type": "string"
     },
     "befund": {
      "type": "string"
     },
     "richtig": {
      "type": "string"
     },
     "abschnitt": {
      "type": "string",
      "pattern": "^[A-GL][1-9][0-9]?$"
     }
    }
   }
  },
  "motto": {
   "type": "object",
   "required": [
    "lat",
    "de",
    "stelle"
   ],
   "properties": {
    "lat": {
     "type": "string"
    },
    "de": {
     "type": "string"
    },
    "stelle": {
     "type": "string"
    }
   }
  },
  "lexicon": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "begriff",
     "bedeutung",
     "abschnitt"
    ],
    "properties": {
     "begriff": {
      "type": "string"
     },
     "bedeutung": {
      "type": "string"
     },
     "abschnitt": {
      "type": "string",
      "pattern": "^[A-GL][1-9][0-9]?$"
     },
     "sprache": {
      "type": "string"
     }
    }
   }
  },
  "repetitorium": {
   "type": "object",
   "required": [
    "nr",
    "code",
    "name_lat",
    "name_de",
    "leitfrage",
    "kompakt"
   ],
   "properties": {
    "nr": {
     "type": "string"
    },
    "code": {
     "const": "L"
    },
    "name_lat": {
     "type": "string"
    },
    "name_de": {
     "type": "string"
    },
    "leitfrage": {
     "type": "string"
    },
    "kompakt": {
     "type": "array",
     "minItems": 2,
     "items": {
      "type": "string"
     }
    },
    "abschnitte": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/abschnitt"
     },
     "description": "4.0: eigene Abschnitte des Repetitoriums (L1 …) vor den generierten Teilen"
    }
   }
  },
  "aenderungen": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "version",
     "datum",
     "text"
    ],
    "properties": {
     "version": {
      "type": "string"
     },
     "datum": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "text": {
      "type": "string"
     }
    }
   }
  }
 },
 "$defs": {
  "text": {
   "type": "string",
   "minLength": 1
  },
  "kapitel": {
   "type": "object",
   "required": [
    "abschnitte",
    "code",
    "einleitung",
    "kompakt",
    "leitfrage",
    "name_de",
    "nr"
   ],
   "additionalProperties": false,
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[A-GL]$"
    },
    "nr": {
     "type": "string"
    },
    "name_lat": {
     "type": "string"
    },
    "name_de": {
     "type": "string"
    },
    "leitfrage": {
     "type": "string"
    },
    "einleitung": {
     "type": "array",
     "minItems": 1,
     "items": {
      "anyOf": [
       {
        "$ref": "#/$defs/text"
       },
       {
        "$ref": "#/$defs/block"
       }
      ]
     },
     "description": "Pflicht: Anschluss an das vorige Kapitel und Wegweiser; darf eine Übersichtsabbildung enthalten"
    },
    "abschnitte": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/abschnitt"
     }
    },
    "kontrollfragen": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "frage",
       "antwort",
       "abschnitt"
      ],
      "properties": {
       "frage": {
        "$ref": "#/$defs/text"
       },
       "antwort": {
        "$ref": "#/$defs/text"
       },
       "abschnitt": {
        "type": "string",
        "pattern": "^[A-GL][1-9][0-9]?$"
       }
      }
     }
    },
    "abschluss": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/block"
     },
     "description": "„Auf einen Blick“ am Kapitelende, vor Kernaussagen und Kontrollfragen"
    },
    "kompakt": {
     "type": "array",
     "minItems": 3,
     "maxItems": 6,
     "items": {
      "type": "string"
     },
     "description": "„In 60 Sekunden“ im Provinzkopf (wie bisher)"
    },
    "anker": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "seiten": {
     "type": "string"
    }
   }
  },
  "abschnitt": {
   "type": "object",
   "required": [
    "code",
    "titel",
    "bloecke"
   ],
   "additionalProperties": false,
   "properties": {
    "code": {
     "type": "string",
     "pattern": "^[A-GL][1-9][0-9]?$",
     "description": "stabil, nie umnummerieren (früher Kachelcode)"
    },
    "titel": {
     "type": "string"
    },
    "anker": {
     "type": "string"
    },
    "quellen": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "bloecke": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/block"
     }
    },
    "dimensionen": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Prüfdimensionen des Moduls, denen der Abschnitt dient"
    },
    "fundstelle": {
     "type": "string",
     "description": "Seiten-, Rz- oder Folienangabe im Abschnittskopf (früher kachel.seite)"
    },
    "wichtig": {
     "type": "boolean",
     "description": "Schlüssel am Abschnittskopf (ersetzt die Relevanzmarken von 3.x); sparsam, höchstens ein Drittel der Abschnitte"
    }
   }
  },
  "block": {
   "type": "object",
   "required": [
    "typ"
   ],
   "properties": {
    "typ": {
     "enum": [
      "absatz",
      "kernsatz",
      "spitzmarke",
      "aufzaehlung",
      "tabelle",
      "abbildung",
      "fallbeispiel",
      "merkband",
      "zitat",
      "steckbrief",
      "glossar",
      "akteure",
      "latinum",
      "definition",
      "kern",
      "formel",
      "rechenweg"
     ]
    },
    "wichtig": {
     "type": "boolean",
     "description": "Schlüssel am linken Rand (Einbettungen: im Titel); sparsam, höchstens ein Viertel der Bausteine"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "typ": {
        "enum": [
         "absatz",
         "kernsatz",
         "definition"
        ]
       }
      }
     },
     "then": {
      "required": [
       "text"
      ],
      "properties": {
       "text": {
        "$ref": "#/$defs/text"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "spitzmarke"
       }
      }
     },
     "then": {
      "required": [
       "art",
       "text"
      ],
      "properties": {
       "art": {
        "enum": [
         "klausurhinweis",
         "austriacum",
         "aktualisierung",
         "luecke",
         "merke",
         "feinheit"
        ]
       },
       "norm": {
        "$ref": "#/$defs/text",
        "description": "Austriacum: österreichische Norm"
       },
       "datum": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Aktualisierung: gilt seit"
       },
       "quelle": {
        "$ref": "#/$defs/text",
        "description": "Aktualisierung: Fundstelle der Änderung"
       },
       "grund": {
        "$ref": "#/$defs/text",
        "description": "Lücke: warum sinngemäß ergänzt"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "aufzaehlung"
       }
      }
     },
     "then": {
      "required": [
       "punkte"
      ],
      "properties": {
       "nummeriert": {
        "type": "boolean"
       },
       "punkte": {
        "type": "array",
        "minItems": 2,
        "items": {
         "$ref": "#/$defs/text"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "tabelle"
       }
      }
     },
     "then": {
      "required": [
       "id",
       "titel",
       "kopf",
       "zeilen"
      ],
      "properties": {
       "spalten": {
        "type": "array",
        "items": {
         "enum": [
          "begriff",
          "text",
          "stichworte",
          "zahl"
         ]
        }
       },
       "aussage": {
        "type": "string"
       },
       "art": {
        "enum": [
         "uebersicht",
         "vergleich"
        ]
       },
       "unterkopf": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "spaltenrollen": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "lesehilfe": {
        "$ref": "#/$defs/text",
        "description": "nur bei anspruchsvollen Vergleichstabellen: wie man die Tabelle liest"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       }
      }
     },
     "then": {
      "required": [
       "id",
       "titel",
       "variante",
       "nachweis"
      ],
      "properties": {
       "variante": {
        "enum": [
         "zeitstrahl",
         "zeitleiste",
         "diagramm",
         "baum",
         "kurve",
         "tkonto",
         "svg",
         "bild"
        ]
       },
       "lesehilfe": {
        "$ref": "#/$defs/text",
        "description": "nur bei anspruchsvollen Grafiken (BPMN, Fluss mit zwei oder mehr Entscheidungen): wie man sie liest; unten angekoppelt"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "fallbeispiel"
       }
      }
     },
     "then": {
      "required": [
       "sachverhalt",
       "loesung"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "merkband"
       }
      }
     },
     "then": {
      "required": [
       "titel",
       "schritte"
      ],
      "properties": {
       "schritte": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
         "type": "object",
         "required": [
          "kopf",
          "text"
         ],
         "properties": {
          "kopf": {
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "rolle": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "zitat"
       }
      }
     },
     "then": {
      "required": [
       "text",
       "quelle"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       },
       "variante": {
        "const": "diagramm"
       }
      },
      "required": [
       "variante"
      ]
     },
     "then": {
      "required": [
       "knoten",
       "kanten"
      ],
      "properties": {
       "stil": {
        "enum": [
         "fluss",
         "bpmn"
        ]
       },
       "knoten": {
        "type": "array",
        "minItems": 2,
        "items": {
         "type": "object",
         "required": [
          "id",
          "art",
          "zeile"
         ],
         "properties": {
          "art": {
           "enum": [
            "start",
            "ende",
            "abbruch",
            "ereignis",
            "aufgabe",
            "zustand",
            "frage",
            "ergebnis",
            "notiz"
           ]
          }
         }
        }
       },
       "kanten": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "von",
          "nach"
         ],
         "properties": {
          "art": {
           "enum": [
            "fluss",
            "nachricht",
            "bezug"
           ]
          },
          "aus": {
           "enum": [
            "oben",
            "unten",
            "links",
            "rechts"
           ]
          },
          "ein": {
           "enum": [
            "oben",
            "unten",
            "links",
            "rechts"
           ]
          }
         }
        }
       },
       "lesehilfe": {
        "$ref": "#/$defs/text",
        "description": "nur bei anspruchsvollen Grafiken (BPMN, Fluss mit zwei oder mehr Entscheidungen): wie man sie liest; unten angekoppelt"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "steckbrief"
       }
      }
     },
     "then": {
      "required": [
       "titel",
       "rolle",
       "felder"
      ],
      "properties": {
       "felder": {
        "type": "array",
        "minItems": 3,
        "items": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "glossar"
       }
      }
     },
     "then": {
      "required": [
       "titel",
       "eintraege"
      ],
      "properties": {
       "eintraege": {
        "type": "array",
        "minItems": 3,
        "items": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {
          "type": "string"
         }
        }
       },
       "latein": {
        "type": "boolean",
        "description": "auch die Latinum-Bausteine des ganzen Werks anfügen (Standard: nein)"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "akteure"
       }
      }
     },
     "then": {
      "required": [
       "id",
       "titel"
      ],
      "properties": {
       "kopf": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
         "type": "string"
        },
        "description": "Spaltenköpfe (Person, Funktion, Zuordnung); Zuordnung ist die Rolle im Farbschlüssel"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "latinum"
       }
      }
     },
     "then": {
      "required": [
       "lat",
       "de",
       "stelle"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "kern"
       }
      }
     },
     "then": {
      "required": [
       "punkte"
      ],
      "properties": {
       "titel": {
        "type": "string",
        "description": "Spitzmarke über der Liste wie in den Kacheln: Inhalt, Kerngehalt, Merkmale …"
       },
       "punkte": {
        "type": "array",
        "minItems": 1,
        "items": {
         "oneOf": [
          {
           "$ref": "#/$defs/text"
          },
          {
           "type": "object",
           "required": [
            "text"
           ],
           "additionalProperties": false,
           "properties": {
            "text": {
             "$ref": "#/$defs/text"
            },
            "wichtig": {
             "type": "boolean"
            }
           }
          }
         ]
        },
        "description": "„**Fachbegriff:** Erklärung in ein bis drei Sätzen“; ein Gerüstwort als Vorspann wird nicht fett gesetzt"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "formel"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/x_formel"
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "rechenweg"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/x_rechenweg"
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       },
       "variante": {
        "const": "kurve"
       }
      },
      "required": [
       "variante"
      ]
     },
     "then": {
      "$ref": "#/$defs/a_kurve"
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       },
       "variante": {
        "const": "tkonto"
       }
      },
      "required": [
       "variante"
      ]
     },
     "then": {
      "$ref": "#/$defs/a_tkonto"
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       },
       "variante": {
        "const": "svg"
       }
      },
      "required": [
       "variante"
      ]
     },
     "then": {
      "$ref": "#/$defs/a_svg"
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       },
       "variante": {
        "const": "baum"
       }
      },
      "required": [
       "variante"
      ]
     },
     "then": {
      "$ref": "#/$defs/a_baum"
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       },
       "variante": {
        "const": "bild"
       }
      },
      "required": [
       "variante"
      ]
     },
     "then": {
      "$ref": "#/$defs/a_bild"
     }
    },
    {
     "if": {
      "properties": {
       "typ": {
        "const": "abbildung"
       },
       "variante": {
        "const": "zeitleiste"
       }
      },
      "required": [
       "variante"
      ]
     },
     "then": {
      "$ref": "#/$defs/a_zeitleiste"
     }
    }
   ]
  },
